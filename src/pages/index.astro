---
import Layout from "../layouts/Layout.astro";
import LectureCard from "../components/LectureCard.astro";
import BlogCard from "../components/BlogCard.astro";
import InstagramCard from "../components/InstagramCard.astro";
import { getLecturesSortedByDate, getAllThemes, LECTURES, formatDateLabel } from "../data/lectures";
import {
  fetchLatestBlogPosts,
  fetchPopularBlogPosts,
  fetchInstagramPosts,
  fetchPodcastList,
  fetchLectureViewCounts,
  rankByEngagementRate,
  formatRelativeDate,
} from "../data/portal";

const lectures = getLecturesSortedByDate();
const themes = getAllThemes();
// ピックアップ枠：ビルド時にランダムで1本（no-JSでも日替わり）。
// クライアント側では読み込みごとに再抽選する（下部 is:inline script）。
const featured = lectures[Math.floor(Math.random() * lectures.length)];
// クライアント再抽選用の最小データ
const heroData = lectures.map((l) => ({
  slug: l.slug,
  title: l.title,
  description: l.description,
  youtubeId: l.youtubeId,
  dateLabel: formatDateLabel(l.date),
  themes: l.themes,
  resumeUrl: l.resumeUrl ?? null,
}));

// 広報ポータルデータ（build時取得・失敗時は空配列）
const [latestBlogs, popularBlogs, instagramPosts, podcasts] = await Promise.all([
  fetchLatestBlogPosts(8),
  fetchPopularBlogPosts(8),
  fetchInstagramPosts(30),
  fetchPodcastList(),
]);
const latestInsta = instagramPosts.slice(0, 6);
const popularInsta = rankByEngagementRate(instagramPosts, 6);
const latestPodcasts = [...podcasts]
  .sort((a, b) => (b.date || "").localeCompare(a.date || ""))
  .slice(0, 4);

// WEB勉強会 視聴回数ランキング（build時にYouTube APIから取得）
const viewCounts = await fetchLectureViewCounts(lectures.map((l) => l.youtubeId));
const popularLectures =
  viewCounts.size > 0
    ? [...lectures]
        .map((l) => ({ ...l, views: viewCounts.get(l.youtubeId) ?? 0 }))
        .sort((a, b) => b.views - a.views)
        .slice(0, 5)
    : [];
const formatViews = (n: number) =>
  n >= 10000 ? `${(n / 10000).toFixed(1)}万` : n.toLocaleString("ja-JP");
---

<Layout title="ごうホームクリニック 訪問診療情報資料室">
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-50 via-white to-brand-100">
    <div class="absolute inset-0 opacity-30 pointer-events-none">
      <div class="absolute -top-32 -right-32 w-96 h-96 bg-brand-200 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-amber-200 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-6 py-16 md:py-24">
      <div class="max-w-3xl">
        <span class="inline-block text-xs font-bold tracking-widest text-brand-600 mb-4 uppercase">
          For Healthcare Professionals
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-brand-900 leading-tight mb-6">
          訪問診療を、<br />
          <span class="text-brand-600">本気で語る</span>場所。
        </h1>
        <p class="text-lg md:text-xl text-brand-700 leading-relaxed mb-8">
          ごうホームクリニックが運営する、訪問診療の情報資料室。<br />
          毎月のWEB勉強会動画を中心に、舞台裏トークも含む現場のリアルを医療職同士で共有しています。
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="#lectures" class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white px-6 py-3 rounded-full font-semibold shadow-md hover:shadow-lg transition-all">
            資料を見る
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a href="/line" class="inline-flex items-center gap-2 bg-white hover:bg-brand-50 text-brand-700 border border-brand-200 px-6 py-3 rounded-full font-semibold transition-all">
            公式LINEに登録する
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured (ピックアップ：読み込みごとにランダム) -->
  {featured && (
    <section class="max-w-6xl mx-auto px-6 -mt-8 relative z-10">
      <div class="bg-white rounded-3xl shadow-xl border border-brand-100 overflow-hidden">
        <div class="grid md:grid-cols-2 gap-0">
          <a id="hero-link" href={`/lectures/${featured.slug}/`} class="relative aspect-video md:aspect-auto bg-brand-100 group block">
            <img
              id="hero-img"
              src={`https://i.ytimg.com/vi/${featured.youtubeId}/maxresdefault.jpg`}
              onerror={`this.src='https://i.ytimg.com/vi/${featured.youtubeId}/hqdefault.jpg'`}
              alt={featured.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-tr from-black/30 to-transparent"></div>
            <div class="absolute top-4 left-4 bg-amber-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow-md">
              ★ ピックアップ
            </div>
            <div class="absolute inset-0 grid place-items-center">
              <div class="w-16 h-16 rounded-full bg-white/95 backdrop-blur grid place-items-center shadow-2xl group-hover:scale-110 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-brand-700 translate-x-0.5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7L8 5z" />
                </svg>
              </div>
            </div>
          </a>
          <div class="p-6 md:p-10 flex flex-col justify-center">
            <span id="hero-date" class="text-xs font-bold tracking-wider text-amber-600 mb-2">{formatDateLabel(featured.date)}</span>
            <h2 id="hero-title" class="text-2xl md:text-3xl font-bold text-brand-900 leading-tight mb-4">{featured.title}</h2>
            <p id="hero-desc" class="text-brand-700 leading-relaxed mb-6">{featured.description}</p>
            <div id="hero-themes" class="flex flex-wrap gap-1.5 mb-6">
              {featured.themes.map((t) => (
                <span class="text-xs px-2.5 py-1 rounded-full bg-brand-50 text-brand-600 border border-brand-100">#{t}</span>
              ))}
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <a id="hero-watch" href={`/lectures/${featured.slug}/`} class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white px-5 py-2.5 rounded-full font-semibold shadow-md hover:shadow-lg transition-all">
                この動画を見る
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7-7 7M5 12h16" />
                </svg>
              </a>
              <a
                id="hero-resume"
                href={featured.resumeUrl ?? "#"}
                target="_blank"
                rel="noopener noreferrer"
                style={featured.resumeUrl ? "" : "display:none"}
                class="inline-flex items-center gap-1.5 font-semibold text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 px-5 py-2.5 rounded-full transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                  <line x1="8" y1="13" x2="16" y2="13" />
                  <line x1="8" y1="17" x2="16" y2="17" />
                </svg>
                レジュメを見る
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ピックアップを読み込みごとに再抽選 -->
  <script is:inline define:vars={{ heroData }}>
    (function () {
      if (!Array.isArray(heroData) || heroData.length === 0) return;
      const pick = heroData[Math.floor(Math.random() * heroData.length)];
      const $ = (id) => document.getElementById(id);
      const img = $("hero-img");
      if (img) {
        img.src = `https://i.ytimg.com/vi/${pick.youtubeId}/maxresdefault.jpg`;
        img.onerror = function () {
          this.onerror = null;
          this.src = `https://i.ytimg.com/vi/${pick.youtubeId}/hqdefault.jpg`;
        };
        img.alt = pick.title;
      }
      const link = $("hero-link");
      if (link) link.href = `/lectures/${pick.slug}/`;
      const watch = $("hero-watch");
      if (watch) watch.href = `/lectures/${pick.slug}/`;
      const date = $("hero-date");
      if (date) date.textContent = pick.dateLabel;
      const title = $("hero-title");
      if (title) title.textContent = pick.title;
      const desc = $("hero-desc");
      if (desc) desc.textContent = pick.description;
      const themes = $("hero-themes");
      if (themes) {
        themes.innerHTML = (pick.themes || [])
          .map(
            (t) =>
              `<span class="text-xs px-2.5 py-1 rounded-full bg-brand-50 text-brand-600 border border-brand-100">#${t}</span>`
          )
          .join("");
      }
      const resume = $("hero-resume");
      if (resume) {
        if (pick.resumeUrl) {
          resume.href = pick.resumeUrl;
          resume.style.display = "";
        } else {
          resume.style.display = "none";
        }
      }
    })();
  </script>

  <!-- ============ 広報ポータル ダッシュボード ============ -->

  <!-- 最新ブログ -->
  {latestBlogs.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pt-20 pb-4">
      <div class="flex items-end justify-between mb-6">
        <div>
          <span class="text-xs font-bold tracking-wider text-brand-600 uppercase">Latest</span>
          <h2 class="text-2xl md:text-3xl font-bold text-brand-900 mt-1">新着ブログ</h2>
        </div>
        <a href="https://gohome-clinic.com/blog/" target="_blank" rel="noopener" class="text-sm text-brand-600 hover:text-brand-800 font-semibold inline-flex items-center gap-1">
          全て見る
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7-7 7M5 12h16" /></svg>
        </a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {latestBlogs.slice(0, 4).map((p) => <BlogCard post={p} />)}
      </div>
    </section>
  )}

  <!-- 新着Instagram -->
  {latestInsta.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pt-12 pb-4">
      <div class="flex items-end justify-between mb-6">
        <div>
          <span class="text-xs font-bold tracking-wider text-pink-600 uppercase">Latest</span>
          <h2 class="text-2xl md:text-3xl font-bold text-brand-900 mt-1">新着 Instagram</h2>
        </div>
        <a href="/instagram/" class="text-sm text-pink-600 hover:text-pink-700 font-semibold inline-flex items-center gap-1">
          詳しく見る
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7-7 7M5 12h16" /></svg>
        </a>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestInsta.slice(0, 3).map((p) => <InstagramCard post={p} />)}
      </div>
    </section>
  )}

  <!-- 新着Podcast -->
  {latestPodcasts.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pt-12 pb-4">
      <div class="flex items-end justify-between mb-6">
        <div>
          <span class="text-xs font-bold tracking-wider text-amber-600 uppercase">Latest</span>
          <h2 class="text-2xl md:text-3xl font-bold text-brand-900 mt-1">新着 Podcast</h2>
        </div>
        <a href="/podcast/" class="text-sm text-amber-600 hover:text-amber-700 font-semibold inline-flex items-center gap-1">
          全エピソード（{podcasts.length}本）
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7-7 7M5 12h16" /></svg>
        </a>
      </div>
      <ul class="divide-y divide-brand-100 bg-white rounded-2xl border border-brand-100 shadow-sm overflow-hidden">
        {latestPodcasts.map((ep) => (
          <li class="group">
            <a href={ep.url} target="_blank" rel="noopener" class="flex items-start gap-3 p-3 md:p-4 hover:bg-amber-50/50 transition-colors">
              <div class="flex-shrink-0 w-24 md:w-28 aspect-video bg-brand-100 rounded overflow-hidden">
                <img src={`https://i.ytimg.com/vi/${ep.youtubeId}/mqdefault.jpg`} alt={ep.title} loading="lazy" class="w-full h-full object-cover" />
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 text-xs text-brand-500 mb-1">
                  {ep.number !== null && <span class="font-bold text-amber-600">#{ep.number}</span>}
                  {ep.date && <span>{formatRelativeDate(ep.date)}</span>}
                  <div class="flex flex-wrap gap-1">
                    {ep.genres.slice(0, 2).map((g) => (
                      <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">{g}</span>
                    ))}
                  </div>
                </div>
                <h3 class="text-sm md:text-base font-semibold text-brand-900 leading-snug group-hover:text-amber-600 transition-colors line-clamp-2">
                  {ep.number !== null ? ep.title.replace(/^\d+/, "").trim() : ep.title}
                </h3>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="hidden md:block w-5 h-5 text-brand-400 group-hover:text-amber-600 transition-colors flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7-7 7M5 12h16" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- 人気ブログ -->
  {popularBlogs.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pt-12 pb-4">
      <div class="flex items-end justify-between mb-6">
        <div>
          <span class="text-xs font-bold tracking-wider text-amber-600 uppercase">Popular</span>
          <h2 class="text-2xl md:text-3xl font-bold text-brand-900 mt-1">人気ブログランキング</h2>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {popularBlogs.slice(0, 4).map((p, i) => <BlogCard post={p} rank={i + 1} />)}
      </div>
    </section>
  )}

  <!-- 人気Instagram -->
  {popularInsta.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pt-12 pb-4">
      <div class="flex items-end justify-between mb-6">
        <div>
          <span class="text-xs font-bold tracking-wider text-amber-600 uppercase">Popular</span>
          <h2 class="text-2xl md:text-3xl font-bold text-brand-900 mt-1">人気 Instagram 投稿</h2>
          <p class="text-sm text-brand-700 mt-1">エンゲージメント率（保存・いいね・コメント数 ÷ リーチ）順</p>
        </div>
        <a href="/instagram/" class="text-sm text-pink-600 hover:text-pink-700 font-semibold inline-flex items-center gap-1">
          全分析を見る
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7-7 7M5 12h16" /></svg>
        </a>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {popularInsta.slice(0, 3).map((p, i) => <InstagramCard post={p} rank={i + 1} metric="engagement" />)}
      </div>
    </section>
  )}

  <!-- Themes Filter -->
  <section id="themes" class="max-w-6xl mx-auto px-6 py-16">
    <div class="mb-8">
      <h2 class="text-2xl md:text-3xl font-bold text-brand-900 mb-2">テーマで探す</h2>
      <p class="text-brand-700">気になるテーマを選ぶと、関連する資料だけが表示されます。</p>
    </div>
    <div class="flex flex-wrap gap-2" id="theme-buttons">
      <button type="button" data-theme-filter="all" class="px-4 py-2 rounded-full text-sm font-medium bg-brand-600 text-white shadow-sm transition-colors">
        すべて <span class="ml-1 opacity-75">({LECTURES.length})</span>
      </button>
      {themes.map((t) => (
        <button type="button" data-theme-filter={t.name} class="px-4 py-2 rounded-full text-sm font-medium bg-white text-brand-700 border border-brand-200 hover:bg-brand-50 transition-colors">
          {t.name} <span class="ml-1 opacity-60">({t.count})</span>
        </button>
      ))}
    </div>
  </section>

  <!-- 人気WEB勉強会ランキング（視聴回数順） -->
  {popularLectures.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pb-8">
      <div class="mb-6">
        <span class="text-xs font-bold tracking-wider text-amber-600 uppercase">Popular</span>
        <h2 class="text-2xl md:text-3xl font-bold text-brand-900 mt-1">人気WEB勉強会ランキング</h2>
        <p class="text-sm text-brand-700 mt-1">YouTube視聴回数の多い順 TOP5</p>
      </div>
      <ol class="divide-y divide-brand-100 bg-white rounded-2xl border border-brand-100 shadow-sm overflow-hidden">
        {popularLectures.map((l, i) => (
          <li class="group">
            <a href={`/lectures/${l.slug}/`} class="flex items-center gap-3 p-3 md:p-4 hover:bg-amber-50/50 transition-colors">
              <span
                class:list={[
                  "flex-shrink-0 grid place-items-center w-8 h-8 rounded-full text-sm font-bold",
                  i === 0
                    ? "bg-amber-400 text-white"
                    : i === 1
                      ? "bg-brand-300 text-white"
                      : i === 2
                        ? "bg-amber-700/80 text-white"
                        : "bg-brand-50 text-brand-600 border border-brand-200",
                ]}
              >
                {i + 1}
              </span>
              <div class="flex-shrink-0 w-24 md:w-32 aspect-video bg-brand-100 rounded overflow-hidden">
                <img
                  src={`https://i.ytimg.com/vi/${l.youtubeId}/mqdefault.jpg`}
                  alt={l.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 text-xs text-brand-500 mb-1">
                  <span class="font-bold text-amber-600 inline-flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                    {formatViews(l.views)} 回視聴
                  </span>
                  <span>{formatDateLabel(l.date)}</span>
                </div>
                <h3 class="text-sm md:text-base font-semibold text-brand-900 leading-snug group-hover:text-amber-600 transition-colors line-clamp-2">
                  {l.title}
                </h3>
              </div>
              {l.resumeUrl && (
                <span
                  class="hidden md:inline-flex flex-shrink-0 items-center gap-1 text-xs font-semibold text-brand-700 bg-brand-50 group-hover:bg-brand-100 border border-brand-200 rounded-full px-3 py-1.5 transition-colors"
                  data-resume-url={l.resumeUrl}
                  role="link"
                  tabindex="0"
                  aria-label={`${l.title} のレジュメを開く`}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="8" y1="13" x2="16" y2="13" /><line x1="8" y1="17" x2="16" y2="17" /></svg>
                  レジュメ
                </span>
              )}
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  <!-- Lecture Grid -->
  <section id="lectures" class="max-w-6xl mx-auto px-6 pb-24">
    <div class="mb-8 flex items-end justify-between">
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-brand-900 mb-2">資料一覧</h2>
        <p class="text-brand-700">
          <span id="visible-count">{LECTURES.length}</span> / {LECTURES.length} 件
        </p>
      </div>
    </div>
    <div id="lecture-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {lectures.map((l) => <LectureCard lecture={l} />)}
    </div>
  </section>

  <!-- LINE CTA -->
  <section class="max-w-6xl mx-auto px-6 pb-24">
    <div class="bg-gradient-to-br from-line to-emerald-600 rounded-3xl p-8 md:p-12 text-white shadow-xl">
      <div class="md:flex items-center justify-between gap-8">
        <div class="mb-6 md:mb-0">
          <h2 class="text-2xl md:text-3xl font-bold mb-3">次回WEB勉強会のご案内を、LINEで配信中</h2>
          <p class="text-white/90 leading-relaxed">
            次回のテーマ・開催日時を、公式LINEから配信しています。<br />
            新着動画もLINEでお知らせします。
          </p>
        </div>
        <a href="/line" class="inline-flex items-center gap-2 bg-white text-emerald-700 px-6 py-3 rounded-full font-bold shadow-md hover:shadow-lg hover:scale-105 transition-all whitespace-nowrap">
          公式LINEを見る
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7-7 7M5 12h16" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-filter]");
    const cards = document.querySelectorAll<HTMLElement>("[data-lecture]");
    const counter = document.getElementById("visible-count");

    function applyFilter(theme: string) {
      let visible = 0;
      cards.forEach((card) => {
        const themes = (card.dataset.themes ?? "").split(",");
        const show = theme === "all" || themes.includes(theme);
        card.toggleAttribute("hidden", !show);
        if (show) visible++;
      });
      if (counter) counter.textContent = visible.toString();
      buttons.forEach((b) => {
        const isActive = b.dataset.themeFilter === theme;
        if (isActive) {
          b.classList.add("bg-brand-600", "text-white", "shadow-sm");
          b.classList.remove("bg-white", "text-brand-700", "border", "border-brand-200");
        } else {
          b.classList.remove("bg-brand-600", "text-white", "shadow-sm");
          b.classList.add("bg-white", "text-brand-700", "border", "border-brand-200");
        }
      });
    }
    buttons.forEach((b) => b.addEventListener("click", () => applyFilter(b.dataset.themeFilter ?? "all")));

    // ランキング行内の「レジュメ」: 親リンク（講座ページ遷移）を抑止して別タブで開く
    document.querySelectorAll<HTMLElement>("[data-resume-url]").forEach((el) => {
      const open = (e: Event) => {
        e.preventDefault();
        e.stopPropagation();
        const url = el.dataset.resumeUrl;
        if (url) window.open(url, "_blank", "noopener,noreferrer");
      };
      el.addEventListener("click", open);
      el.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") open(e);
      });
    });
  </script>
</Layout>
