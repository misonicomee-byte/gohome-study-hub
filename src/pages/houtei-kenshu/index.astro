---
import Layout from "../../layouts/Layout.astro";

const loginUrl = "/api/auth/line/start?returnTo=/houtei-kenshu/portal/";
---

<Layout
  title="居宅介護支援事業所 法定研修"
  description="ごうホームクリニックが運営する、居宅介護支援事業所向けの法定研修ページです。スマホのLINEでQR認証し、研修ページへ移動します。"
>
  <section class="bg-white border-b border-brand-100">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
      <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-10 items-center">
        <div>
          <span class="inline-flex items-center rounded-full bg-brand-50 border border-brand-100 text-brand-700 px-3 py-1 text-xs font-bold tracking-wider">
            居宅介護支援事業所向け
          </span>
          <h1 class="mt-5 text-3xl md:text-5xl font-bold text-brand-900 leading-tight">
            法定研修ページ
          </h1>
          <p class="mt-5 text-lg text-brand-700 leading-relaxed">
            受講ページへの入室には、公式LINEを利用した本人確認を行います。PC画面に表示されるLINEログインQRコードをスマホのLINEで読み取り、研修案内や更新情報の配信とあわせて安全に移動できます。
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={loginUrl}
              class="inline-flex items-center justify-center gap-2 bg-line hover:brightness-95 text-white px-6 py-3 rounded-full font-semibold shadow-md hover:shadow-lg transition-all"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.508.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
              スマホのLINEでQR認証して入室
            </a>
          </div>
          <p class="mt-3 text-sm text-brand-600">
            パスワードは使用しません。本人確認と研修案内のために公式LINEログインを利用します。
          </p>
          <p id="auth-message" class="hidden mt-5 rounded-xl border px-4 py-3 text-sm font-medium"></p>
        </div>
        <div class="bg-brand-50 border border-brand-100 rounded-2xl p-6 md:p-8">
          <h2 class="text-xl font-bold text-brand-900">対象コンテンツ</h2>
          <ul class="mt-5 space-y-3 text-brand-700 leading-relaxed">
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 rounded-full bg-brand-500 shrink-0"></span>
              <span>全事業所向けの法定研修動画</span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 rounded-full bg-brand-500 shrink-0"></span>
              <span>特定事業所加算対応の上乗せ研修</span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 rounded-full bg-brand-500 shrink-0"></span>
              <span>研修実施記録・受講者名簿・確認資料</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const params = new URLSearchParams(window.location.search);
      const auth = params.get("auth");
      if (!auth) return;

      const messages = {
        required: "受講ページに入るには、LINEで本人確認をしてください。",
        expired: "認証の有効期限が切れました。もう一度LINEで本人確認をしてください。",
        failed: "LINE認証を完了できませんでした。時間をおいて再度お試しください。",
        cancelled: "LINE認証がキャンセルされました。",
        friend_required: "公式LINEの友だち追加を確認できませんでした。友だち追加後に再度お試しください。",
        config: "認証設定が未完了です。管理者に連絡してください。",
      };

      const box = document.getElementById("auth-message");
      if (!box) return;
      box.textContent = messages[auth] || messages.failed;
      box.classList.remove("hidden");
      box.classList.add("border-amber-200", "bg-amber-50", "text-amber-800");
    })();
  </script>
</Layout>
