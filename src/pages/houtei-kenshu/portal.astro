    }

    .training-toc-grid li:nth-child(2n + 1) .training-toc-card {
      --toc-accent: var(--color-mint-pulse);
    }

    .training-toc-grid li:nth-child(2n) .training-toc-card {
      --toc-accent: var(--color-electric-yellow);
    }

    .training-toc-grid li:nth-child(4n + 1) .training-toc-card {
