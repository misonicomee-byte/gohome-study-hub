---
import Layout from "../../layouts/Layout.astro";
import { PASSING_SCORE, QUIZ_DISPLAY_COUNT, trainingModules } from "../../data/houteiKenshu.mjs";

const rosterRows = Array.from({ length: 12 }, (_, index) => index + 1);

// The single playful object, modelled on the reference hero: a column of
// stacked hexagonal segments (wood, walnut, terrazzo, yellow, pink-topped
// crown) with bright cubes docking at its sides. Textures come from SVG
// patterns; self-shadow from translucent overlays (light from upper left).
// Transform layers never share a node: position (attribute transform) >
// loop motion (lifter/docker/floater) > drop-in (toc-tower-block).
const SEG_H = 24;
const HEX_TOP_POINTS = "34,0 17,15 -17,15 -34,0 -17,-15 17,-15";
const HEX_FACES = {
  left: `-34,0 -17,15 -17,${15 + SEG_H} -34,${SEG_H}`,
  front: `-17,15 17,15 17,${15 + SEG_H} -17,${15 + SEG_H}`,
  right: `17,15 34,0 34,${SEG_H} 17,${15 + SEG_H}`,
};
// One motion beat per element, staggered across the 16s loop so something
// is always moving: right-to-left drawer (terrazzo), peg out-in (yellow,
// mint), bottom-to-top crown lift, left-to-right drawer (yellow band),
// plus ever-bobbing floaters.
const tocTowerSegments = [
  { y: 142, top: "#eedcb8", side: "url(#toc-wood)", drop: 0, base: true },
  { y: 118, top: "#3b332e", side: "#2b2523", drop: 0.12 },
  { y: 94, top: "#f3f1ea", side: "url(#toc-terrazzo)", drop: 0.24, loop: "docker", loopStyle: "--loop-delay: 0.9s; --dock-amp: -12px;" },
  { y: 70, top: "#fff100", side: "#fff100", drop: 0.36, loop: "docker", loopStyle: "--loop-delay: 11.8s; --dock-amp: 14px;" },
  { y: 46, top: "#ff4fa3", side: "url(#toc-terrazzo)", drop: 0.48, loop: "lifter", loopStyle: "--loop-delay: 6.4s; --lift-amp: -10px;" },
];
const TOWER_FACES = {
  yellow: "--ft: #fff100; --fl: #e3d600; --fr: #bfb500;",
  mint: "--ft: #d1ffca; --fl: #b5efaa; --fr: #93dc86;",
  white: "--ft: #ffffff; --fl: #e9ebee; --fr: #d4d7db;",
  magenta: "--ft: #ff4fa3; --fl: #e02f86; --fr: #b8236c;",
};
const tocTowerCubes = [
  { tone: "mint", x: 50, y: 104, scale: 0.8, drop: 0.55, loop: "docker", loopStyle: "--loop-delay: 9s; --dock-amp: -16px;", behind: true },
  { tone: "yellow", x: 150, y: 96, scale: 0.9, drop: 0.65, loop: "docker", loopStyle: "--loop-delay: 3.4s; --dock-amp: 16px;" },
  { tone: "magenta", x: 152, y: 54, scale: 0.55, drop: 0.75, loop: "floater", loopStyle: "--float-duration: 4.2s; --float-amp: -18px; --sway-x: -6px;" },
  { tone: "yellow", x: 58, y: 46, scale: 0.5, drop: 0.85, loop: "floater", loopStyle: "--float-duration: 3.6s; --float-amp: -20px; --sway-x: 5px;" },
  { tone: "white", x: 102, y: 10, scale: 0.45, drop: 0.95, loop: "floater", loopStyle: "--float-duration: 4.8s; --float-amp: -16px; --sway-x: -4px;" },
].map((cube) => ({
  ...cube,
  style: `${TOWER_FACES[cube.tone]} --drop-delay: ${cube.drop}s;`,
}));
const TOWER_LOOP_CLASS = {
  lifter: "toc-tower-lifter",
  docker: "toc-tower-docker",
  floater: "toc-tower-floater",
};
---

<Layout
  title="法定研修ポータル"
  description="LINEログインで本人確認済みの方向けの法定研修ポータルです。研修動画、小テスト、講義別の受講証明書を確認できます。"
>
  <section class="max-w-6xl mx-auto px-6 py-10 md:py-14 no-print">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <span class="text-xs font-bold tracking-wider text-brand-600 uppercase">Training Portal</span>
        <h1 class="mt-2 text-3xl md:text-4xl font-bold text-brand-900">ケアマネ向け法定研修</h1>
        <p class="mt-3 max-w-3xl text-brand-700 leading-relaxed">
          講義ごとに動画視聴、小テスト、修了書発行を行えます。小テストは10問の中から毎回5問をランダム表示し、全問正解でその講義の修了書を発行できます。
        </p>
      </div>
      <a
        href="/api/auth/line/logout"
        class="inline-flex items-center justify-center rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-700 hover:bg-brand-50 transition-colors"
      >
        ログアウト
      </a>
    </div>

    <div class="mt-8 rounded-xl border border-brand-100 bg-white p-5 shadow-sm">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end">
        <div class="flex-1">
          <h2 class="text-lg font-bold text-brand-900">受講者情報</h2>
          <p class="mt-1 text-sm text-brand-600">修了書に転記されます。未入力のままでも修了書を発行できます。</p>
        </div>
        <form id="learner-form" class="grid flex-[2] gap-3 md:grid-cols-2">
          <label class="grid gap-1 text-sm font-bold text-brand-800">
            受講者名
            <input
              id="learner-name"
              name="name"
              autocomplete="name"
              class="rounded-lg border border-brand-200 px-3 py-2 font-normal text-brand-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
              placeholder="山田 太郎"
            />
          </label>
          <label class="grid gap-1 text-sm font-bold text-brand-800">
            所属
            <input
              id="learner-organization"
              name="organization"
              autocomplete="organization"
              class="rounded-lg border border-brand-200 px-3 py-2 font-normal text-brand-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
              placeholder="居宅介護支援事業所名"
            />
          </label>
        </form>
      </div>
    </div>

    <nav class="training-toc-stage mt-8" aria-label="研修目次">
      <div class="training-toc-header">
        <div class="training-toc-heading">
          <span class="training-toc-kicker">Training Map</span>
          <h2>研修を選ぶ</h2>
          <p>必要な講義へ移動し、講義ごとに小テストと修了書を進められます。</p>
        </div>
        <span class="training-toc-tower" aria-hidden="true">
          <svg viewBox="0 0 200 196" role="presentation" focusable="false">
            <defs>
              <g id="toc-iso-block">
                <polygon points="0,-12 24,0 0,12 -24,0" fill="var(--ft)" />
                <polygon points="-24,0 0,12 0,32 -24,20" fill="var(--fl)" />
                <polygon points="24,0 0,12 0,32 24,20" fill="var(--fr)" />
              </g>
              <pattern id="toc-terrazzo" width="13" height="13" patternUnits="userSpaceOnUse">
                <rect width="13" height="13" fill="#f3f1ea" />
                <circle cx="2.5" cy="3" r="0.9" fill="#b9b2a2" />
                <circle cx="8.5" cy="1.5" r="0.7" fill="#8f887a" />
                <circle cx="5" cy="9" r="1" fill="#cdc6b6" />
                <circle cx="11" cy="10" r="0.6" fill="#7c7466" />
                <circle cx="1" cy="11.4" r="0.5" fill="#a49c8c" />
                <circle cx="11.6" cy="5.4" r="0.5" fill="#565048" />
              </pattern>
              <pattern id="toc-wood" width="16" height="9" patternUnits="userSpaceOnUse">
                <rect width="16" height="9" fill="#e2c69b" />
                <path d="M0 2.2 H16 M0 5.4 H16 M0 7.8 H16" stroke="#c6a06b" stroke-width="0.7" fill="none" />
              </pattern>
            </defs>
            {tocTowerCubes.filter((cube) => cube.behind).map((cube) => (
              <g transform={`translate(${cube.x}, ${cube.y}) scale(${cube.scale})`}>
                <g class={TOWER_LOOP_CLASS[cube.loop]} style={cube.loopStyle}>
                  <use href="#toc-iso-block" class="toc-tower-block" style={cube.style} />
                </g>
              </g>
            ))}
            {tocTowerSegments.map((segment) => (
              <g transform={`translate(100, ${segment.y})`}>
                <g class={segment.loop ? TOWER_LOOP_CLASS[segment.loop] : undefined} style={segment.loopStyle}>
                  <g
                    class={`toc-tower-block${segment.base ? " toc-tower-base" : ""}`}
                    style={`--drop-delay: ${segment.drop}s;`}
                  >
                    <polygon points={HEX_FACES.left} fill={segment.side} />
                    <polygon points={HEX_FACES.front} fill={segment.side} />
                    <polygon points={HEX_FACES.front} fill="rgba(0, 0, 0, 0.1)" />
                    <polygon points={HEX_FACES.right} fill={segment.side} />
                    <polygon points={HEX_FACES.right} fill="rgba(0, 0, 0, 0.22)" />
                    <polygon points={HEX_TOP_POINTS} fill={segment.top} />
                  </g>
                </g>
              </g>
            ))}
            {tocTowerCubes.filter((cube) => !cube.behind).map((cube) => (
              <g transform={`translate(${cube.x}, ${cube.y}) scale(${cube.scale})`}>
                <g class={TOWER_LOOP_CLASS[cube.loop]} style={cube.loopStyle}>
                  <use href="#toc-iso-block" class="toc-tower-block" style={cube.style} />
                </g>
              </g>
            ))}
          </svg>
        </span>
        <div class="training-toc-rule" aria-label={`合格基準 ${PASSING_SCORE}%`}>
          <span>合格基準</span>
          <strong>{PASSING_SCORE}%</strong>
          <small>表示5問すべて正解</small>
        </div>
      </div>
      <ol class="training-toc-grid">
        {trainingModules.map((item) => (
          <li>
            <a
              href={`#module-${item.id}`}
              data-toc-card
              data-module-id={item.id}
              data-status-tone="pending"
              class="training-toc-card"
            >
              <span class="training-toc-card__accent" aria-hidden="true"></span>
              <span class="training-toc-card__main">
                <span class="training-toc-number">{item.displayNumber}</span>
                <span class="training-toc-copy">
                  <span class="training-toc-title">{item.title}</span>
                  <span class="training-toc-meta">
                    <span>{item.category}</span>
                    <span>{item.duration}</span>
                  </span>
                </span>
              </span>
              <span class="training-toc-card__side">
                <span
                  data-toc-status
                  data-module-id={item.id}
                  class="training-toc-status shrink-0 rounded-full bg-slate-100 px-2 py-1 text-xs font-bold text-slate-600"
                >
                  未受講
                </span>
                <span class="training-toc-arrow" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-12 no-print">
    <div class="grid gap-8">
      {trainingModules.map((item) => (
        <article
          id={`module-${item.id}`}
          data-module-card
          data-module-id={item.id}
          class="scroll-mt-6 rounded-xl border border-brand-100 bg-white p-5 md:p-6 shadow-sm"
        >
          <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <span class="inline-flex min-w-12 justify-center rounded-full bg-brand-50 px-3 py-1 text-sm font-bold text-brand-700 ring-1 ring-brand-100">
                  {item.displayNumber}
                </span>
                <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700 ring-1 ring-amber-100">
                  {item.category}
                </span>
                <span class="text-sm font-semibold text-brand-500">{item.duration}</span>
              </div>
              <h2 class="mt-3 text-2xl font-bold text-brand-900">{item.title}</h2>
              <p class="mt-2 text-sm text-brand-600">この講義は単独で小テストと修了書発行ができます。</p>
            </div>
            <span
              data-module-status
              data-module-id={item.id}
              class="self-start rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600"
            >
              未受講
            </span>
          </div>

          <div class="mt-5 overflow-hidden rounded-lg border border-brand-100 bg-black">
            <video
              controls
              playsinline
              preload="metadata"
              data-module-video
              data-module-id={item.id}
              src={`/api/houtei-kenshu/video/${item.slug}`}
              class="aspect-video w-full bg-black"
            >
              動画を再生できません。ブラウザを更新して再度お試しください。
            </video>
          </div>

          <section class="mt-5 rounded-lg border border-brand-100 bg-brand-50 p-4 md:p-5">
            <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
              <div>
                <h3 class="text-lg font-bold text-brand-900">小テスト</h3>
                <p class="mt-1 text-sm text-brand-600">10問の中からランダムに5問表示しています。全問正解が必要です。</p>
              </div>
              <span
                data-quiz-summary
                data-module-id={item.id}
                class="self-start rounded-full bg-white px-3 py-1 text-xs font-bold text-brand-600 ring-1 ring-brand-100"
              >
                未採点
              </span>
            </div>

            <div
              data-quiz-host
              data-module-id={item.id}
              class="mt-4 grid gap-4"
              aria-live="polite"
            ></div>

            <p
              data-quiz-result
              data-module-id={item.id}
              class="mt-4 min-h-5 text-sm font-bold"
              aria-live="polite"
            ></p>

            <div class="mt-4 flex flex-wrap gap-3">
              <button
                type="button"
                data-grade-quiz
                data-module-id={item.id}
                class="rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
              >
                採点する
              </button>
              <button
                type="button"
                data-complete-module
                data-module-id={item.id}
                class="rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-700 transition-colors hover:bg-brand-50"
              >
                受講完了にする
              </button>
              <button
                type="button"
                data-create-certificate
                data-module-id={item.id}
                class="rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-700 transition-colors hover:bg-brand-50"
              >
                修了書を作成
              </button>
            </div>
          </section>
        </article>
      ))}
    </div>
  </section>

  <section id="certificate-panel" class="max-w-6xl mx-auto px-6 pb-16 no-print">
    <div class="rounded-xl border border-brand-100 bg-white p-5 md:p-6 shadow-sm">
      <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
        <div>
          <span class="text-xs font-bold tracking-wider text-brand-600 uppercase">Certificate</span>
          <h2 class="mt-2 text-2xl md:text-3xl font-bold text-brand-900">講義別 修了書・受講者名簿</h2>
          <p id="certificate-panel-message" class="mt-3 text-brand-700 leading-relaxed">
            各講義の小テストに全問正解し、受講完了後に修了書と受講者名簿を作成できます。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="certificate-preview" class="certificate-print mx-auto mb-16 hidden max-w-5xl px-6 py-8 md:px-10 md:py-10">
    <div class="no-print mb-4 flex flex-wrap justify-end gap-3">
      <button
        id="certificate-preview-print"
        type="button"
        class="rounded-full bg-brand-600 px-5 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
      >
        印刷
      </button>
      <button
        id="certificate-preview-pdf"
        type="button"
        class="rounded-full border border-brand-200 bg-white px-5 py-2 text-sm font-semibold text-brand-700 transition-colors hover:bg-brand-50"
      >
        PDF保存
      </button>
    </div>
    <div class="certificate-sheet border-4 border-brand-700 bg-white p-8 md:p-12 text-center">
      <div class="text-sm font-bold tracking-[0.35em] text-brand-600">CERTIFICATE</div>
      <h2 class="mt-4 text-3xl md:text-5xl font-bold text-brand-900">修了証</h2>
      <p class="mt-8 text-lg text-brand-700">
        以下の者は、下記の研修を受講し、小テストに全問正解したことを証明します。
      </p>

      <div class="mt-10 grid gap-4 text-left text-brand-900">
        <div class="grid grid-cols-[6rem_1fr] border-b border-brand-200 pb-3">
          <span class="font-bold text-brand-600">受講者</span>
          <span id="certificate-preview-name" class="font-bold"></span>
        </div>
        <div class="grid grid-cols-[6rem_1fr] border-b border-brand-200 pb-3">
          <span class="font-bold text-brand-600">所属</span>
          <span id="certificate-preview-organization"></span>
        </div>
        <div class="grid grid-cols-[6rem_1fr] border-b border-brand-200 pb-3">
          <span class="font-bold text-brand-600">研修名</span>
          <span id="certificate-preview-module" class="font-bold"></span>
        </div>
        <div class="grid grid-cols-[6rem_1fr] border-b border-brand-200 pb-3">
          <span class="font-bold text-brand-600">受講日</span>
          <span id="certificate-preview-date"></span>
        </div>
      </div>

      <div class="mt-10 flex flex-col items-center gap-2 text-brand-900">
        <div id="certificate-preview-issuer" class="text-lg font-bold">ごうホームクリニック 訪問診療情報資料室</div>
        <div id="certificate-preview-serial" class="text-xs text-brand-500"></div>
      </div>
    </div>

    <section id="certificate-roster" class="certificate-roster mt-8 border-4 border-brand-700 bg-white p-8 md:p-12 text-brand-900">
      <div class="text-center">
        <div class="text-sm font-bold tracking-[0.35em] text-brand-600">ATTENDANCE ROSTER</div>
        <h2 class="mt-4 text-3xl md:text-4xl font-bold">受講者名簿</h2>
        <p class="mt-4 text-sm text-brand-600">
          サーバーには保存されません。印刷またはPDF保存後、各自で記入してください。
        </p>
      </div>

      <div class="mt-8 grid gap-3 text-sm md:grid-cols-3">
        <div class="border-b border-brand-300 pb-2">
          <span class="font-bold text-brand-600">研修名</span>
          <div id="certificate-roster-module" class="mt-1 min-h-6 font-semibold"></div>
        </div>
        <div class="border-b border-brand-300 pb-2">
          <span class="font-bold text-brand-600">実施日</span>
          <div id="certificate-roster-date" class="mt-1 min-h-6"></div>
        </div>
        <div class="border-b border-brand-300 pb-2">
          <span class="font-bold text-brand-600">事業所名</span>
          <div id="certificate-roster-organization" class="mt-1 min-h-6"></div>
        </div>
      </div>

      <div class="mt-8 overflow-hidden border border-brand-700">
        <table class="w-full border-collapse text-left text-sm">
          <thead class="bg-brand-50 text-brand-800">
            <tr>
              <th class="w-12 border border-brand-700 px-2 py-3 text-center">No.</th>
              <th class="border border-brand-700 px-3 py-3">受講者名</th>
              <th class="border border-brand-700 px-3 py-3">所属</th>
              <th class="w-32 border border-brand-700 px-3 py-3">受講日</th>
            </tr>
          </thead>
          <tbody>
            {rosterRows.map((row) => (
              <tr>
                <td class="border border-brand-700 px-2 py-4 text-center font-semibold">{row}</td>
                <td class="border border-brand-700 px-3 py-4"></td>
                <td class="border border-brand-700 px-3 py-4"></td>
                <td class="border border-brand-700 px-3 py-4"></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </section>

  <div
    id="portal-toast"
    class="fixed bottom-5 left-1/2 z-50 hidden max-w-[min(92vw,40rem)] -translate-x-1/2 rounded-lg px-4 py-3 text-sm font-bold shadow-lg no-print"
    role="status"
    aria-live="polite"
  ></div>

  <script is:inline define:vars={{ trainingModules, quizDisplayCount: QUIZ_DISPLAY_COUNT, passingScore: PASSING_SCORE }}>
    (function () {
      const STORAGE_KEY = "gohome:houtei-kenshu:v2";
      const modules = Array.isArray(trainingModules) ? trainingModules : [];
      const selectedQuizzes = Object.fromEntries(
        modules.map((module) => [module.id, selectQuizzes(module)]),
      );

      function loadState() {
        try {
          const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
          return normalizeState(parsed);
        } catch {
          return normalizeState({});
        }
      }

      function normalizeState(parsed) {
        return {
          learner: parsed.learner && typeof parsed.learner === "object" ? parsed.learner : {},
          completed: parsed.completed && typeof parsed.completed === "object" ? parsed.completed : {},
          answers: parsed.answers && typeof parsed.answers === "object" ? parsed.answers : {},
          results: {},
          certificates: parsed.certificates && typeof parsed.certificates === "object" ? parsed.certificates : {},
          activeCertificateModuleId: typeof parsed.activeCertificateModuleId === "string" ? parsed.activeCertificateModuleId : null,
        };
      }

      let state = loadState();

      function saveState() {
        const persisted = {
          learner: state.learner,
          completed: state.completed,
          answers: state.answers,
          certificates: state.certificates,
          activeCertificateModuleId: state.activeCertificateModuleId,
        };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(persisted));
      }

      function selectQuizzes(module) {
        const quizzes = Array.isArray(module.quizzes) ? module.quizzes : [];
        return shuffle(quizzes)
          .slice(0, quizDisplayCount)
          .map((quiz) => ({
            ...quiz,
            options: shuffle(Array.isArray(quiz.options) ? quiz.options : []),
          }));
      }

      function shuffle(items) {
        const copied = [...items];
        for (let index = copied.length - 1; index > 0; index -= 1) {
          const target = Math.floor(Math.random() * (index + 1));
          [copied[index], copied[target]] = [copied[target], copied[index]];
        }
        return copied;
      }

      function renderQuizHosts() {
        modules.forEach((module) => {
          const host = document.querySelector(`[data-quiz-host][data-module-id="${module.id}"]`);
          if (!host) return;
          const questions = selectedQuizzes[module.id] || [];
          host.innerHTML = "";
          questions.forEach((quiz, questionIndex) => {
            const fieldset = document.createElement("fieldset");
            fieldset.className = "rounded-lg border border-brand-100 bg-white p-4";
            fieldset.dataset.quizId = quiz.id;
            fieldset.dataset.moduleId = module.id;

            const legend = document.createElement("legend");
            legend.className = "px-2 text-sm font-bold text-brand-900";
            legend.textContent = `問${questionIndex + 1}`;
            fieldset.appendChild(legend);

            const question = document.createElement("p");
            question.className = "mt-1 font-semibold text-brand-900";
            question.textContent = quiz.question;
            fieldset.appendChild(question);

            const options = document.createElement("div");
            options.className = "mt-3 grid gap-2";
            quiz.options.forEach((option) => {
              const label = document.createElement("label");
              label.className = "flex cursor-pointer gap-3 rounded-lg border border-brand-100 bg-white px-4 py-3 text-brand-800 transition-colors hover:border-brand-300";

              const input = document.createElement("input");
              input.type = "radio";
              input.name = `quiz-${module.id}-${quiz.id}`;
              input.value = option.id;
              input.className = "mt-1 h-4 w-4 accent-brand-600";
              input.dataset.quizOption = "true";
              input.dataset.moduleId = module.id;
              input.dataset.quizId = quiz.id;

              const text = document.createElement("span");
              text.textContent = option.label;

              label.append(input, text);
              options.appendChild(label);
            });
            fieldset.appendChild(options);

            const feedback = document.createElement("p");
            feedback.className = "mt-2 min-h-5 text-sm font-bold";
            feedback.dataset.quizFeedback = "true";
            feedback.dataset.moduleId = module.id;
            feedback.dataset.quizId = quiz.id;
            fieldset.appendChild(feedback);

            host.appendChild(fieldset);
          });
        });

        document.querySelectorAll("[data-quiz-option]").forEach((input) => {
          input.addEventListener("change", () => {
            const moduleId = input.getAttribute("data-module-id");
            const quizId = input.getAttribute("data-quiz-id");
            if (!moduleId || !quizId) return;
            state.answers[moduleId] = state.answers[moduleId] || {};
            state.answers[moduleId][quizId] = input.value;
            delete state.results[moduleId];
            state.completed[moduleId] = false;
            delete state.certificates[moduleId];
            if (state.activeCertificateModuleId === moduleId) state.activeCertificateModuleId = null;
            saveState();
            render();
          });
        });
      }

      function render() {
        renderLearner();
        modules.forEach((module) => {
            const status = getModuleStatus(module.id);
            setStatusPill(document.querySelector(`[data-module-status][data-module-id="${module.id}"]`), status);
            setStatusPill(document.querySelector(`[data-toc-status][data-module-id="${module.id}"]`), status);
            const tocCard = document.querySelector(`[data-toc-card][data-module-id="${module.id}"]`);
            if (tocCard) tocCard.setAttribute("data-status-tone", status.tone);

          const summary = document.querySelector(`[data-quiz-summary][data-module-id="${module.id}"]`);
          if (summary) {
            const result = state.results[module.id];
            if (!result) {
              summary.textContent = "未採点";
              summary.className = "self-start rounded-full bg-white px-3 py-1 text-xs font-bold text-brand-600 ring-1 ring-brand-100";
            } else if (result.passed) {
              summary.textContent = `合格 ${result.correct}/${result.total}`;
              summary.className = "self-start rounded-full bg-brand-100 px-3 py-1 text-xs font-bold text-brand-700 ring-1 ring-brand-200";
            } else {
              summary.textContent = `再確認 ${result.correct}/${result.total}`;
              summary.className = "self-start rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800 ring-1 ring-amber-200";
            }
          }

          restoreAnswers(module.id);
          renderQuizFeedback(module.id);
          renderActionButtons(module.id);
        });
        renderCertificate();
      }

      function renderLearner() {
        setInputValue("learner-name", state.learner.name || "");
        setInputValue("learner-organization", state.learner.organization || "");
      }

      function restoreAnswers(moduleId) {
        const answers = state.answers[moduleId] || {};
        document
          .querySelectorAll(`[data-quiz-option][data-module-id="${moduleId}"]`)
          .forEach((input) => {
            const quizId = input.getAttribute("data-quiz-id");
            input.checked = quizId ? answers[quizId] === input.value : false;
          });
      }

      function renderQuizFeedback(moduleId) {
        const module = findModule(moduleId);
        const result = state.results[moduleId];
        const resultElement = document.querySelector(`[data-quiz-result][data-module-id="${moduleId}"]`);
        if (resultElement) {
          if (!result) {
            resultElement.textContent = "";
            resultElement.className = "mt-4 min-h-5 text-sm font-bold";
          } else if (result.passed) {
            resultElement.textContent = "全問正解です。受講完了ボタンを押せます。";
            resultElement.className = "mt-4 min-h-5 text-sm font-bold text-brand-700";
          } else if (!result.completed) {
            resultElement.textContent = "小テストを完了してください。";
            resultElement.className = "mt-4 min-h-5 text-sm font-bold text-amber-700";
          } else {
            resultElement.textContent = "不正解の設問があります。講義の該当箇所を見直してから再度回答してください。";
            resultElement.className = "mt-4 min-h-5 text-sm font-bold text-amber-700";
          }
        }

        (selectedQuizzes[moduleId] || []).forEach((quiz) => {
          const feedback = document.querySelector(`[data-quiz-feedback][data-module-id="${moduleId}"][data-quiz-id="${quiz.id}"]`);
          if (!feedback) return;
          if (!result || !result.completed) {
            feedback.textContent = "";
            feedback.className = "mt-2 min-h-5 text-sm font-bold";
            return;
          }
          const answer = state.answers[moduleId]?.[quiz.id];
          if (answer === quiz.answer) {
            feedback.textContent = "正解です。";
            feedback.className = "mt-2 min-h-5 text-sm font-bold text-brand-700";
          } else {
            feedback.textContent = module
              ? `${module.title}の該当箇所を見直してください。`
              : "講義の該当箇所を見直してください。";
            feedback.className = "mt-2 min-h-5 text-sm font-bold text-amber-700";
          }
        });
      }

      function renderActionButtons(moduleId) {
        const canComplete = state.results[moduleId]?.passed === true;
        const completed = state.completed[moduleId] === true;
        const createButton = document.querySelector(`[data-create-certificate][data-module-id="${moduleId}"]`);
        const completeButton = document.querySelector(`[data-complete-module][data-module-id="${moduleId}"]`);

        if (completeButton) {
          completeButton.textContent = completed ? "受講完了済み" : "受講完了にする";
          completeButton.className = completed
            ? "rounded-full bg-brand-100 px-4 py-2 text-sm font-semibold text-brand-700 ring-1 ring-brand-200"
            : canComplete
              ? "rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
              : "rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-700 transition-colors hover:bg-brand-50";
        }

        if (createButton) {
          createButton.disabled = !completed;
          createButton.className = completed
            ? "rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
            : "rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-slate-400 disabled:cursor-not-allowed";
        }
      }

      function getModuleStatus(moduleId) {
        if (state.certificates[moduleId]) return { label: "修了書発行済み", tone: "complete" };
        if (state.completed[moduleId]) return { label: "修了", tone: "complete" };
        const result = state.results[moduleId];
        if (result?.passed) return { label: "小テスト合格", tone: "ready" };
        if (result && !result.passed) return { label: "見直し", tone: "review" };
        return { label: "未受講", tone: "pending" };
      }

          function setStatusPill(element, status) {
            if (!element) return;
            element.textContent = status.label;
            const base = element.hasAttribute("data-toc-status")
              ? "training-toc-status shrink-0 rounded-full px-2 py-1 text-xs font-bold"
              : "self-start rounded-full px-3 py-1 text-xs font-bold";
        const tones = {
          complete: "bg-brand-100 text-brand-700 ring-1 ring-brand-200",
          ready: "bg-emerald-100 text-emerald-800 ring-1 ring-emerald-200",
          review: "bg-amber-100 text-amber-800 ring-1 ring-amber-200",
          pending: "bg-slate-100 text-slate-600",
        };
        element.className = `${base} ${tones[status.tone] || tones.pending}`;
      }

      function gradeModule(moduleId, shouldToast = true) {
        const questions = selectedQuizzes[moduleId] || [];
        const answers = state.answers[moduleId] || {};
        const total = questions.length;
        const answered = questions.filter((quiz) => answers[quiz.id]).length;
        const correct = questions.filter((quiz) => answers[quiz.id] === quiz.answer).length;
        const completed = answered === total && total > 0;
        const percentage = total === 0 ? 0 : Math.round((correct / total) * 100);
        const passed = completed && percentage >= passingScore;
        state.results[moduleId] = { correct, total, answered, completed, percentage, passed };
        if (!passed) {
          state.completed[moduleId] = false;
          delete state.certificates[moduleId];
          if (state.activeCertificateModuleId === moduleId) state.activeCertificateModuleId = null;
        }
        saveState();
        render();

        if (shouldToast) {
          if (!completed) {
            showToast("小テストを完了してください。", "warning");
          } else if (!passed) {
            showToast("不正解の設問があります。講義の該当箇所を見直してから再度回答してください。", "warning");
          } else {
            showToast("全問正解です。受講完了ボタンを押せます。", "success");
          }
        }

        return state.results[moduleId];
      }

      function completeModule(moduleId) {
        const result = state.results[moduleId] || gradeModule(moduleId, false);
        if (!result.completed) {
          showToast("小テストを完了してください。", "warning");
          render();
          return false;
        }
        if (!result.passed) {
          showToast("不正解の設問があります。講義の該当箇所を見直してから再度回答してください。", "warning");
          render();
          return false;
        }
        state.completed[moduleId] = true;
        saveState();
        render();
        showToast("受講完了にしました。修了書を作成できます。", "success");
        return true;
      }

      function createCertificate(moduleId, shouldScroll = true) {
        const module = findModule(moduleId);
        if (!module) return null;
        if (state.completed[moduleId] !== true) {
          const result = state.results[moduleId];
          if (!result?.completed) {
            showToast("小テストを完了してください。", "warning");
          } else if (!result?.passed) {
            showToast("不正解の設問があります。講義の該当箇所を見直してから再度回答してください。", "warning");
          } else {
            showToast("受講完了ボタンを押してください。", "warning");
          }
          return null;
        }

        syncLearnerFromInputs();

        state.certificates[moduleId] = {
          moduleId,
          moduleTitle: module.title,
          displayNumber: module.displayNumber,
          category: module.category,
          name: state.learner.name.trim(),
          organization: state.learner.organization?.trim() || "",
          issuedAt: new Date().toISOString(),
          serial: createSerial(module),
        };
        state.activeCertificateModuleId = moduleId;
        saveState();
        render();
        showToast(`${module.title}の修了書を作成しました。`, "success");
        if (shouldScroll) {
          document.getElementById("certificate-preview")?.scrollIntoView({ behavior: "smooth", block: "start" });
        }
        return state.certificates[moduleId];
      }

      function renderCertificate() {
        const preview = document.getElementById("certificate-preview");
        const panelMessage = document.getElementById("certificate-panel-message");
        if (!preview) return;

        const moduleId = state.activeCertificateModuleId;
        const certificate = moduleId ? state.certificates[moduleId] : null;
        if (!certificate) {
          preview.classList.add("hidden");
          if (panelMessage) {
            panelMessage.textContent = "各講義の小テストに全問正解し、受講完了後に修了書と受講者名簿を作成できます。";
          }
          return;
        }

        setText("certificate-preview-name", certificate.name || "");
        setText("certificate-preview-organization", certificate.organization || "");
        setText("certificate-preview-module", `${certificate.displayNumber} ${certificate.moduleTitle}`);
        setText("certificate-preview-date", formatDate(certificate.issuedAt));
        setText("certificate-preview-serial", `証明書番号: ${certificate.serial}`);
        setText("certificate-roster-module", `${certificate.displayNumber} ${certificate.moduleTitle}`);
        setText("certificate-roster-date", formatDate(certificate.issuedAt));
        setText("certificate-roster-organization", certificate.organization || "");
        if (panelMessage) {
          panelMessage.textContent = `現在表示中: ${certificate.displayNumber} ${certificate.moduleTitle} の修了書・受講者名簿`;
        }
        preview.classList.remove("hidden");
      }

      function syncLearnerFromInputs() {
        state.learner = {
          name: document.getElementById("learner-name")?.value.trim() || "",
          organization: document.getElementById("learner-organization")?.value.trim() || "",
        };
      }

      function findModule(moduleId) {
        return modules.find((module) => module.id === moduleId);
      }

      function setText(id, text) {
        const element = document.getElementById(id);
        if (element) element.textContent = text;
      }

      function setInputValue(id, value) {
        const element = document.getElementById(id);
        if (element && document.activeElement !== element) element.value = value;
      }

      function createSerial(module) {
        const now = new Date();
        const date = new Intl.DateTimeFormat("ja-JP", {
          timeZone: "Asia/Tokyo",
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
        }).format(now).replace(/\D/g, "");
        const random = Math.random().toString(36).slice(2, 8).toUpperCase();
        return `GHC-HK-${module.displayNumber.replace(/\W/g, "")}-${date}-${random}`;
      }

      function formatDate(value) {
        return new Intl.DateTimeFormat("ja-JP", {
          timeZone: "Asia/Tokyo",
          year: "numeric",
          month: "long",
          day: "numeric",
        }).format(new Date(value));
      }

      function showToast(message, tone) {
        const toast = document.getElementById("portal-toast");
        if (!toast) return;
        toast.textContent = message;
        toast.className = tone === "success"
          ? "fixed bottom-5 left-1/2 z-50 max-w-[min(92vw,40rem)] -translate-x-1/2 rounded-lg bg-brand-700 px-4 py-3 text-sm font-bold text-white shadow-lg no-print"
          : "fixed bottom-5 left-1/2 z-50 max-w-[min(92vw,40rem)] -translate-x-1/2 rounded-lg bg-amber-100 px-4 py-3 text-sm font-bold text-amber-900 shadow-lg ring-1 ring-amber-200 no-print";
        window.clearTimeout(showToast.timeoutId);
        showToast.timeoutId = window.setTimeout(() => {
          toast.classList.add("hidden");
        }, 4200);
      }

      document.querySelectorAll("[data-grade-quiz]").forEach((button) => {
        button.addEventListener("click", () => {
          const moduleId = button.getAttribute("data-module-id");
          if (moduleId) gradeModule(moduleId);
        });
      });

      document.querySelectorAll("[data-complete-module]").forEach((button) => {
        button.addEventListener("click", () => {
          const moduleId = button.getAttribute("data-module-id");
          if (moduleId) completeModule(moduleId);
        });
      });

      document.querySelectorAll("[data-create-certificate]").forEach((button) => {
        button.addEventListener("click", () => {
          const moduleId = button.getAttribute("data-module-id");
          if (moduleId) createCertificate(moduleId);
        });
      });

      ["certificate-preview-print", "certificate-preview-pdf"].forEach((id) => {
        const button = document.getElementById(id);
        if (!button) return;
        button.addEventListener("click", () => window.print());
      });

      document.querySelectorAll("[data-module-video]").forEach((video) => {
        video.addEventListener("ended", () => {
          const moduleId = video.getAttribute("data-module-id");
          if (!moduleId || state.completed[moduleId]) return;
          showToast("動画を最後まで再生しました。小テストに全問正解後、受講完了にできます。", "success");
        });
      });

      ["learner-name", "learner-organization"].forEach((id) => {
        const input = document.getElementById(id);
        if (!input) return;
        input.addEventListener("input", () => {
          syncLearnerFromInputs();
          saveState();
        });
      });

      renderQuizHosts();
      render();
    })();
  </script>

