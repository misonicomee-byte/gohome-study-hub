      --toc-accent-duration: 7s;
    }

    .training-toc-grid li:nth-child(4n + 2) .training-toc-card {
      --toc-accent-delay: -3s;
      --toc-accent-duration: 8s;
    }

    .training-toc-grid li:nth-child(4n + 3) .training-toc-card {
      --toc-accent-delay: -5s;
      --toc-accent-duration: 9s;
    }

    .training-toc-grid li:nth-child(4n) .training-toc-card {
      --toc-accent-delay: -2s;
      --toc-accent-duration: 6s;
    }

    .training-toc-card[data-status-tone="complete"] {
      background: color-mix(in srgb, var(--color-mint-pulse) 55%, var(--color-pure-white));
    }

    .training-toc-card[data-status-tone="ready"] {
      background: color-mix(in srgb, var(--color-electric-yellow) 30%, var(--color-pure-white));
    }

    .training-toc-card[data-status-tone="review"] {
      background: color-mix(in srgb, var(--color-electric-yellow) 14%, var(--color-pure-white));
    }

    .training-toc-card__main,
    .training-toc-card__side {
      position: relative;
      z-index: 1;
    }

    .training-toc-card__main {
      display: flex;
      min-width: 0;
      gap: 14px;
    }

    .training-toc-number {
      flex: 0 0 auto;
      color: var(--color-ink-black);
      font-size: 34px;
